<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- ① 잔여 게이지 (남은/지출 토글) -->
        <receiver
            android:name=".RemainWidgetReceiver"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remain_widget_info" />
        </receiver>

        <!-- ② 심플 한 줄 -->
        <receiver
            android:name=".BalanceWidgetReceiver"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/balance_widget_info" />
        </receiver>

        <!-- ③ 오늘 코치 -->
        <receiver
            android:name=".DailyCoachWidgetReceiver"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_coach_widget_info" />
        </receiver>

        <!-- ④ 가계부 -->
        <receiver
            android:name=".LedgerWidgetReceiver"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ledger_widget_info" />
        </receiver>

        <!-- 날짜 변경(자정 알람·시각/시간대 변경) → 위젯 4종 갱신 (사이클·오늘 지표 갱신) -->
        <receiver
            android:name=".WidgetDayChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
